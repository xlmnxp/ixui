{
  "branches": [
    "main",
    { "name": "feat/ixui-ui", "channel": "beta", "prerelease": "beta" }
  ],
  "plugins": [
    ["@semantic-release/commit-analyzer", { "preset": "conventionalcommits" }],
    ["@semantic-release/release-notes-generator", { "preset": "conventionalcommits" }],
    ["@semantic-release/changelog", { "changelogFile": "CHANGELOG.md" }],
    ["@semantic-release/npm", { "npmPublish": false }],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "npm run build && rm -f ixui-*.zip ixui-*.sha256 && (cd dist && zip -r -q ../ixui-${nextRelease.version}.zip .) && sha256sum ixui-${nextRelease.version}.zip > ixui-${nextRelease.version}.sha256"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["package.json", "package-lock.json", "CHANGELOG.md"],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          { "path": "ixui-*.zip", "label": "ixui ${nextRelease.version} (dist, zipped)" },
          { "path": "ixui-*.sha256", "label": "SHA-256 checksum" }
        ]
      }
    ]
  ]
}
